APP_NAME="LOA Auth Platform"
APP_ENV=production
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=https://auth.lyceumalabang.edu.ph

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lyceumalabang_auth_db
DB_USERNAME=lyceumalabang_auth_admin
# Provide the real password at deploy time; never commit it.
DB_PASSWORD=YOUR_DB_PASSWORD_HERE

JWT_SECRET=YOUR_JWT_SECRET_HERE
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=10080

CORS_ALLOWED_ORIGINS=https://auth.lyceumalabang.edu.ph,https://aces-api.lyceumalabang.edu.ph,https://e-cert.vercel.app
L5_SWAGGER_OPEN_API_SPEC_VERSION=3.1.0

AUTH_REDIRECT_URL=https://auth.lyceumalabang.edu.ph
AUTH_ALLOWED_REDIRECTS=https://auth.lyceumalabang.edu.ph,https://e-cert.vercel.app
AUTH_ADMIN_GROUP=loa-auth-admin

ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY_HERE
ENCRYPTION_KEY_PREVIOUS=

CACHE_STORE=redis
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_EXPIRE_ON_CLOSE=true
SESSION_HTTP_ONLY=true
SESSION_SECURE=true
SESSION_SAME_SITE=lax

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@lyceumalabang.edu.ph"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_EMAIL=admin@lyceumalabang.edu.ph
ADMIN_PASSWORD=Admin123!
ADMIN_NAME="SuperAdmin"
