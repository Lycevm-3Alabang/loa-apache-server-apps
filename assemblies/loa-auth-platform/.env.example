APP_NAME="LOA Auth Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Manila
APP_URL=http://localhost:8080

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=loa_auth
DB_USERNAME=root
DB_PASSWORD=

JWT_SECRET=
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=10080

CORS_ALLOWED_ORIGINS=https://auth.loa.edu.ph,https://consult.loa.edu.ph,https://cert.loa.edu.ph
L5_SWAGGER_OPEN_API_SPEC_VERSION=3.1.0

AUTH_REDIRECT_URL=https://consult.loa.edu.ph
AUTH_ALLOWED_REDIRECTS=https://consult.loa.edu.ph,https://cert.loa.edu.ph

CACHE_STORE=file
SESSION_DRIVER=database
SESSION_LIFETIME=5
SESSION_EXPIRE_ON_CLOSE=true
SESSION_HTTP_ONLY=true
SESSION_SECURE=false
SESSION_SAME_SITE=lax

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@loa.edu.ph"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_EMAIL=admin@loa.edu.ph
ADMIN_PASSWORD=password123
ADMIN_NAME=Super Admin
