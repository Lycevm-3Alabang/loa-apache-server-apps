APP_NAME="LOA Auth Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=https://auth.lyceumalabang.edu.ph

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lyceumalabang_auth_db
DB_USERNAME=lyceumalabang_auth_admin
# Provide the real password at deploy time; never commit it.
DB_PASSWORD=

# --- JWT ---------------------------------------------------------------------
# Generate once: openssl rand -hex 32  — keep in sync with other LOA apps.
JWT_SECRET=51d2ded9a6eb061e178049599f29d811b3a88e7fde75fece28a7b7590edf6eb4
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=10080

CORS_ALLOWED_ORIGINS=https://auth.lyceumalabang.edu.ph,https://aces-api.lyceumalabang.edu.ph,https://cert-api.lyceumalabang.edu.ph,https://staging-loa-vericert.vercel.app
L5_SWAGGER_OPEN_API_SPEC_VERSION=3.1.0

AUTH_REDIRECT_URL=https://auth.lyceumalabang.edu.ph
AUTH_ALLOWED_REDIRECTS=https://auth.lyceumalabang.edu.ph,https://staging-loa-vericert.vercel.app,https://e-cert.vercel.app
AUTH_ADMIN_GROUP=loa-auth-admin

TENANT_SLUG=loa-e-cert

# --- Encryption (SSO redirect payloads) ---------------------------------------
# MUST be identical to the key used by Cert/Consult apps.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_EXPIRE_ON_CLOSE=true
SESSION_HTTP_ONLY=true
SESSION_SECURE=true
SESSION_SAME_SITE=lax

MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=587
MAIL_USERNAME=no-reply@lyceumalabang.edu.ph
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@lyceumalabang.edu.ph"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_EMAIL=admin@lyceumalabang.edu.ph
ADMIN_NAME="Super Admin"
