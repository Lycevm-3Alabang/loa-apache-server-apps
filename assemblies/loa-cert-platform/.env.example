APP_NAME="LOA Cert Platform"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Manila
APP_URL=https://cert-api.lyceumalabang.edu.ph

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=lyceumalabang_e_cert_db
# Provide the real password at deploy time; never commit it.
DB_USERNAME=lyceumalabang_auth_admin
DB_PASSWORD=

# --- JWT (must be byte-identical to Auth Platform) ---------------------------
# Generate once: openssl rand -hex 32 — copy SAME value to Auth's JWT_SECRET.
JWT_SECRET=51d2ded9a6eb061e178049599f29d811b3a88e7fde75fece28a7b7590edf6eb4
JWT_ACCESS_TTL=15
JWT_REFRESH_TTL=10080

CORS_ALLOWED_ORIGINS=https://cert-api.lyceumalabang.edu.ph,https://staging-loa-vericert.vercel.app
L5_SWAGGER_OPEN_API_SPEC_VERSION=3.1.0

AUTH_ALLOWED_REDIRECTS=https://cert-api.lyceumalabang.edu.ph,https://staging-loa-vericert.vercel.app,https://e-cert.vercel.app
# Local Docker: cert container reaches auth via the compose service name.
AUTH_BASE_URL=http://auth-nginx
# API key for server-to-server calls (tenant member management). Format: tk_...:tsk_...
AUTH_API_KEY=

CERT_TENANT_SLUG=loa-e-cert
CERT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001

# Refresh cookie
CERT_REFRESH_COOKIE=loa_cert_refresh
CERT_REFRESH_COOKIE_SECURE=true

# --- Encryption (SSO redirect payloads) --------------------------------------
# MUST be identical to Auth Platform's ENCRYPTION_KEY.
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=
ENCRYPTION_KEY_PREVIOUS=

CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_EXPIRE_ON_CLOSE=true
SESSION_HTTP_ONLY=true
SESSION_SECURE=true
SESSION_SAME_SITE=lax

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@lyceumalabang.edu.ph"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_EMAIL=admin@lyceumalabang.edu.ph
ADMIN_PASSWORD=
ADMIN_NAME="Super Admin"
